<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:id="@+id/main"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_marginTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                layout="@layout/view_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"/>

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|top"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back"/>

        </FrameLayout>

        <TextView
            style="@style/CL.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/tajawal_bold"
            android:text="@string/personal_info"/>

        <TextView
            style="@style/CL.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/tajawal_medium"
            android:text="@string/tell_us"/>

        <!--  اختيار الدور: الأول (يمين) = عميل  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/cardClient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_role_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🙋"
                        android:textSize="48sp"/>

                    <TextView
                        android:id="@+id/tvClientTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/role_client"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:fontFamily="@font/tajawal_medium"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_client_sub"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/tajawal_medium"
                        android:textSize="14sp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/badgeClient"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge"
                    android:padding="5dp"
                    android:src="@drawable/ic_check"
                    android:visibility="visible"
                    android:contentDescription="@null"/>

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/cardWorker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_role_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👷"
                        android:textSize="48sp"/>

                    <TextView
                        android:id="@+id/tvWorkerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/role_worker"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:fontFamily="@font/tajawal_medium"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_worker_sub"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/tajawal_medium"
                        android:textSize="14sp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/badgeWorker"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge"
                    android:padding="5dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="@null"/>

            </FrameLayout>

        </LinearLayout>

        <!--  الاسم الأول (يمين) / الأخير (يسار)  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFirstName"
                style="@style/CL.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="@string/first_name"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_medium"
                    android:inputType="textPersonName"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLastName"
                style="@style/CL.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="@string/last_name"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_medium"
                    android:inputType="textPersonName"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCity"
            style="@style/CL.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/city"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_location">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal_medium"
                android:inputType="text"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!--  التخصصات: تظهر للعامل فقط (visibility من الجافا)  -->
        <LinearLayout
            android:id="@+id/layoutSpecialties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/specialties"
                android:textColor="@color/navy"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/specialties_sub"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSpecialties"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="10dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="blacksmith"
                    android:text="@string/sp_blacksmith"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="carpentry"
                    android:text="@string/sp_carpentry"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="plumbing"
                    android:text="@string/sp_plumbing"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="electric"
                    android:text="@string/sp_electric"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="internet"
                    android:text="@string/sp_internet"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="ac"
                    android:text="@string/sp_ac"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="garden"
                    android:text="@string/sp_garden"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="paint"
                    android:text="@string/sp_paint"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="building"
                    android:text="@string/sp_building"/>

                <com.google.android.material.chip.Chip
                    style="@style/CL.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:tag="cleaning"
                    android:text="@string/sp_cleaning"/>

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/CL.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/tajawal_medium"
            android:text="@string/next"/>

    </LinearLayout>

</ScrollView>